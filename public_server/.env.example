# Copy to .env on the server and fill in. Never commit the real .env.
#
#   cp .env.example .env && nano .env

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# The Public Server gets its own database. It must NOT share one with the
# school server: the whole point of the split is that this machine, which is
# reachable from the internet, never holds the pupil photos, the camera
# feeds or the staff accounts.
DATABASE_URL=postgresql://smartschool:CHANGE_ME@localhost/smartschool_public

# Docker bilan ishlatsangiz DATABASE_URL ni compose o'zi tuzadi -- faqat
# parolni shu yerga yozing. Docker'siz o'rnatishda esa yuqoridagi
# DATABASE_URL ishlatiladi va bu qator e'tiborsiz qoladi.
POSTGRES_PASSWORD=CHANGE_ME

# --------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------
# Signs the parent and pupil access tokens. Anyone who knows it can mint a
# token for any pupil in the school, so it must be a long random string --
# and it must be different from the school server's own secret.
#
# Generate one:   openssl rand -hex 32
#
# Changing it later invalidates every issued token: parents and pupils are
# all signed out and have to log in again. Harmless, but do it deliberately.
SMARTSCHOOL_PUBLIC_AUTH_SECRET=CHANGE_ME

# --------------------------------------------------------------------------
# Push notifications (optional)
# --------------------------------------------------------------------------
# Absolute path to the Firebase service-account JSON. Leave empty and the
# server still runs -- notification rows are recorded and marked "pending"
# instead of being delivered.
FIREBASE_CREDENTIALS=/opt/smartschool/public_server/firebase-credentials.json
